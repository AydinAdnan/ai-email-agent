# Python cache
__pycache__/
*.py[cod]

# Build artifacts
build/
dist/
wheels/
*.egg-info/

# Environment variables
.env

# Virtual environments
.venv/

# tool cache
.pytest_cache/
.ruff_cache/
.freebuff/

# OS files
.DS_Store
Thumbs.db

# Local run artifacts (wajo sim run --trace, and --store rules)
traces/
preferences.jsonl

# The plan, the papers and the dataset stay local. routes.md is part of the build, so the
# directory is ignored entry by entry rather than wholesale.
docs/*
!docs/routes.md
