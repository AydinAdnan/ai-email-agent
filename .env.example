[TEMPLATE]
# Copy to .env and fill in. The CLI loads this file from the repository root, and an
# already-exported variable wins over it.

# Who proposes decisions, for every command that proposes. Set it here once and the
# commands need no --provider at all. One value picks the whole proposer: an endpoint, or
# an endpoint with a decision model in front of it.
#   WAJO_PROVIDER=openrouter+jev   Jev answers the four-way route, the endpoint does the work
#   WAJO_PROVIDER=openrouter       the endpoint answers both
#   WAJO_PROVIDER=rules            the offline stand-in, no key needed
# A value that names no known provider is ignored rather than breaking the CLI.
WAJO_PROVIDER=rules

# OpenRouter (the endpoint behind "openrouter", and the key Jev is reached through, since
# its decisions API is served by OpenRouter too)
OPENROUTER_API_KEY=

# Overrides the endpoint's default model for any run.
# WAJO_MODEL=inference-net/schematron-v2-small

# The decision model the "+jev" recipe routes with, pinned rather than floatable.
# WAJO_JEV_MODEL=~typesafe/jev-latest

# Only if you use --provider openai instead.
OPENAI_API_KEY=
