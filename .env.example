# Copy to .env and fill in. The CLI loads this file from the repository root, and an
# already-exported variable wins over it.

# Who proposes decisions: the offline rules, or a model endpoint.
#   uv run wajo sim run --provider openrouter
# WAJO_PROVIDER is not read yet; pass --provider.

# OpenRouter (default endpoint for the wajo provider "openrouter")
OPENROUTER_API_KEY=

# Overrides the endpoint's default model for any run.
# WAJO_MODEL=inference-net/schematron-v2-small

# Only if you use --provider openai instead.
OPENAI_API_KEY=
